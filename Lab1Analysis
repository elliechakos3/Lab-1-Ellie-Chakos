# Part 3: Twilight Flats

flat_dir = Path(r"C:\ASTR362_Files\Lab1_TwilightFlats_Sample")

if not flat_dir.exists():
    raise FileNotFoundError(f"Twilight flats folder does not exist: {flat_dir}")
    
flat_files = sorted(
    path for path in flat_dir.iterdir()
    if path.is_file() and path.suffix.lower() in {".fit", ".fits"})

print("Twilight flats folder:", flat_dir)
print("Number of flat files found:", len(flat_files))
print("Files:", flat_files)

if not flat_files:
    raise FileNotFoundError("No .fit or .fits files found in the sample folder.")

if "avg_bias" not in globals():
    raise NameError("Run the bias-image section first so avg_bias is defined.")

flat_hdus = [
    fits.open(path, memmap=True, do_not_scale_image_data=True)
    for path in flat_files]

try:
    number_of_flats = len(flat_hdus)
    image_height, image_width = avg_bias.shape
    bias_float = avg_bias.astype(np.float32)

    flat_medians = []

    for path, hdul in zip(flat_files, flat_hdus):
        header = hdul[0].header
        bscale = header.get("BSCALE", 1.0)
        bzero = header.get("BZERO", 0.0)

        raw = hdul[0].data

        if raw.shape != avg_bias.shape:
            raise ValueError(
                f"Image shape mismatch for {path}: "
                f"{raw.shape} versus bias shape {avg_bias.shape}")

        corrected = (
            raw.astype(np.float32) * bscale + bzero
        ) / 16.0 + 1.0 - bias_float

        flat_median = np.median(corrected)

        if flat_median == 0:
            raise ValueError(f"Bias-corrected median is zero for {path}")

        flat_medians.append(flat_median)
        del corrected

    print("Image shape:", avg_bias.shape)
    print("Flat medians:", flat_medians)

    median_normalized_flat = np.empty(
        (image_height, image_width),
        dtype=np.float32)

    rows_per_strip = 16

    for y0 in range(0, image_height, rows_per_strip):
        y1 = min(y0 + rows_per_strip, image_height)
        bias_strip = bias_float[y0:y1, :]

        normalized_strip_stack = np.empty(
            (number_of_flats, y1 - y0, image_width),
            dtype=np.float32)

        for i, hdul in enumerate(flat_hdus):
            header = hdul[0].header
            bscale = header.get("BSCALE", 1.0)
            bzero = header.get("BZERO", 0.0)

            raw_strip = hdul[0].data[y0:y1, :]

            corrected_strip = (raw_strip.astype(np.float32) * bscale + bzero) / 16.0 + 1.0 - bias_strip

            normalized_strip_stack[i] = corrected_strip / flat_medians[i]

        median_normalized_flat[y0:y1, :] = np.median(
            normalized_strip_stack,
            axis=0)

        print(f"Processed rows {y0} to {y1 - 1}")
        del normalized_strip_stack

finally:
    for hdul in flat_hdus:
        hdul.close()


print("Median normalized flat shape:", median_normalized_flat.shape)
y0, x0 = 1000, 1000
size = 200
flat_region = median_normalized_flat[y0:y0 + size, x0:x0 + size]

plt.figure(figsize=(8, 8))
