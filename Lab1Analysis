#Part 5: Correcting Science Images

science_files = [
    Path(r"C:\ASTR362_Files\denebimages-0003.fit"),
    Path(r"C:\ASTR362_Files\POph-0001.fit"),
    Path(r"C:\ASTR362_Files\Lab 1 Images\shaedirimages-0003.fit"),
]

dark_by_exposure = {
    10: dark10_bias_corrected,
    35: dark35_bias_corrected,
}

if "avg_bias" not in globals():
    raise NameError("Run the bias section first so avg_bias is defined.")

if "median_normalized_flat" not in globals():
    raise NameError(
        "Run the twilight-flat section first so median_normalized_flat is defined."
    )

for duration, dark_image in dark_by_exposure.items():
    if dark_image.shape != avg_bias.shape:
        raise ValueError(
            f"The {duration}-second dark shape {dark_image.shape} "
            f"does not match the bias shape {avg_bias.shape}."
        )

if median_normalized_flat.shape != avg_bias.shape:
    raise ValueError(
        f"The flat shape {median_normalized_flat.shape} "
        f"does not match the bias shape {avg_bias.shape}."
    )


def get_exposure_seconds(header):
    """Read exposure time from a common FITS header keyword."""
    for keyword in ("EXPTIME", "EXPOSURE", "EXP_TIME"):
        if keyword in header:
            return float(header[keyword])

    raise KeyError(
        "No exposure-time keyword found in this FITS header. "
        "Check the header and enter that image's exposure time manually."
    )


calibrated_images = {}

for science_path in science_files:
    if not science_path.exists():
        raise FileNotFoundError(f"Science image not found: {science_path}")

    science_raw = fits.getdata(science_path)
    header = fits.getheader(science_path)

    science = science_raw.astype(np.float32) / 16.0 + 1.0

    science_exposure = get_exposure_seconds(header)
    print(f"\n{science_path.name}: {science_exposure} seconds")

    dark_exposure = min(
        dark_by_exposure,
        key=lambda duration: abs(duration - science_exposure)
    )
    dark_image = dark_by_exposure[dark_exposure]

    scaled_dark = (science_exposure / dark_exposure) * dark_image

    calibrated = (
        science
        - scaled_dark
        - avg_bias
    ) / median_normalized_flat

    calibrated_images[science_path.stem] = calibrated

    print("Selected dark:", dark_exposure, "seconds")
    print("Calibrated image shape:", calibrated.shape)

    plt.figure(figsize=(8, 8))
    plt.imshow(
        calibrated,
        cmap="gray",
        origin="lower",
        vmin=np.percentile(calibrated, 1),
        vmax=np.percentile(calibrated, 99),
    )
    plt.colorbar(label="ADU")
    plt.title(f"Calibrated {science_path.stem}")
    plt.xlabel("Pixel x")
    plt.ylabel("Pixel y")
    plt.show()

    output_path = science_path.with_name(
        f"{science_path.stem}_calibrated.npy"
    )
    np.save(output_path, calibrated)
    print("Saved:", output_path)
