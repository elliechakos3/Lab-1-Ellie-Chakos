# Part 2: Dark Images

def load_dark_stack(folder):
    """Load and convert all .fit/.fits images in a folder."""
    folder = Path(folder)

    if not folder.exists():
        raise FileNotFoundError(f"Folder does not exist: {folder}")

    dark_files = sorted(
        path for path in folder.iterdir()
        if path.is_file() and path.suffix.lower() in {".fit", ".fits"}
    )

    print(f"\nFolder: {folder}")
    print(f"Dark files found: {len(dark_files)}")
    print("First few files:", dark_files[:5])

    if not dark_files:
        raise FileNotFoundError(f"No .fit or .fits files found in {folder}")

    dark_images = []

    for path in dark_files:
        raw = fits.getdata(path)
        image = raw / 16 + 1
        dark_images.append(image)

    dark_stack = np.stack(dark_images)
    print("Dark stack shape:", dark_stack.shape)

    return dark_stack

